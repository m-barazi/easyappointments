#!/bin/bash

REPO_URL="https://github.com/m-barazi/easyappointments.git"

# If the web root is not a git checkout of this repo (e.g. Hostinger only cloned
# docker-compose.yml into it), remove any stray files and clone the app source.
if [ ! -d ".git" ] || [ "$(git remote get-url origin 2>/dev/null)" != "$REPO_URL" ]; then
    echo "➜ App source missing, preparing /var/www/html and cloning repository"
    rm -rf .[!.]* ..?* *
    git clone "$REPO_URL" .
fi

echo "➜ Ignore Permission Changes"
git config core.fileMode false || true

echo "➜ Set Correct Permissions"
chmod -R 777 storage

echo "➜ Prepare Configuration"
if [ ! -f "config.php" ]; then
    cat > config.php <<EOF
<?php
/* ----------------------------------------------------------------------------
 * Easy!Appointments - Online Appointment Scheduler
 *
 * @package     EasyAppointments
 * @author      A.Tselegidis <alextselegidis@gmail.com>
 * @copyright   Copyright (c) Alex Tselegidis
 * @license     https://opensource.org/licenses/GPL-3.0 - GPLv3
 * @link        https://easyappointments.org
 * @since       v1.0.0
 * ---------------------------------------------------------------------------- */

/**
 * Easy!Appointments Configuration File
 *
 * This file is generated automatically on first container start. Override
 * values by setting the corresponding environment variables.
 */
class Config
{
    // ------------------------------------------------------------------------
    // GENERAL SETTINGS
    // ------------------------------------------------------------------------

    const BASE_URL = '${BASE_URL:-http://localhost}';
    const LANGUAGE = '${LANGUAGE:-english}';
    const DEBUG_MODE = ${DEBUG_MODE:-false};

    // ------------------------------------------------------------------------
    // DATABASE SETTINGS
    // ------------------------------------------------------------------------

    const DB_HOST = '${DB_HOST:-mysql}';
    const DB_NAME = '${DB_NAME:-easyappointments}';
    const DB_USERNAME = '${DB_USERNAME:-user}';
    const DB_PASSWORD = '${DB_PASSWORD:-password}';
}
EOF
fi

echo "➜ Install Composer Dependencies"
[[ -d vendor ]] || composer install --no-dev --optimize-autoloader

echo "➜ Install NPM Dependencies"
[[ -d node_modules ]] || npm install

echo "➜ Build Project Assets"
[[ -d assets/vendor ]] || npx gulp compile

echo "➜ Listen To Incoming Requests"
php-fpm
