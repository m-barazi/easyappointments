#!/bin/bash

REPO_URL="https://github.com/m-barazi/easyappointments.git"

# If the web root is not a git checkout of this repo (e.g. Hostinger only cloned
# docker-compose.yml into it), remove any stray files and clone the app source.
if [ ! -d ".git" ] || [ "$(git remote get-url origin 2>/dev/null)" != "$REPO_URL" ]; then
    echo "➜ App source missing, preparing /var/www/html and cloning repository"
    rm -rf .[!.]* ..?* *
    git clone "$REPO_URL" .
fi

echo "➜ Ignore Permission Changes"
git config core.fileMode false || true

echo "➜ Set Correct Permissions"
chmod -R 777 storage

echo "➜ Install Composer Dependencies"
[[ -d vendor ]] || composer install --no-dev --optimize-autoloader

echo "➜ Install NPM Dependencies"
[[ -d node_modules ]] || npm install

echo "➜ Build Project Assets"
[[ -d assets/vendor ]] || npx gulp compile

echo "➜ Listen To Incoming Requests"
php-fpm
